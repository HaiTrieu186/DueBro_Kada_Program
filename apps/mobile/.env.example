# ==============================================================================
# Due Bro Mobile — Cấu hình Biến Môi Trường (Environment Variables)
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép file này thành .env: cp .env.example .env (hoặc copy .env.example .env trên Windows)
# 2. Điền thông tin kết nối Supabase phù hợp với môi trường của bạn:
#
# CÁCH 1: Dùng Supabase Cloud (Khuyến nghị cho cả nhóm dùng chung DB)
# - Lấy tại: https://supabase.com/dashboard -> Chọn Project -> Settings -> API
# EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# CÁCH 2: Dùng Supabase Local (Chạy qua Docker: npx supabase start)
# - Nếu test trên Web hoặc Máy ảo Android (Android Studio):
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# - Nếu test trên Điện thoại thật (quét QR Expo Go trên cùng mạng WiFi):
#   Thay 127.0.0.1 bằng địa chỉ IP LAN của máy tính (xem bằng lệnh `ipconfig`)
#   EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.100:54321
# ==============================================================================

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-local-anon-key-for-development
