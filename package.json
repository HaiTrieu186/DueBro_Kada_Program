{
  "name": "duebro-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Due Bro — The Neutral Bro for Roommate Matching & Household Chore Management",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "admin:dev": "npm --workspace=@duebro/admin run dev",
    "admin:build": "npm --workspace=@duebro/admin run build",
    "mobile:start": "npm --workspace=duebro-mobile run start",
    "mobile:tunnel": "npm --workspace=duebro-mobile run tunnel",
    "mobile:web": "npm --workspace=duebro-mobile run web",
    "mobile:android": "npm --workspace=duebro-mobile run android",
    "mobile:typecheck": "npm --workspace=duebro-mobile run typecheck",
    "gen:types": "supabase gen types typescript --local > packages/shared-types/src/database.types.ts"
  },
  "keywords": [
    "duebro",
    "expo",
    "react-native",
    "supabase",
    "gemini"
  ],
  "license": "UNLICENSED"
}
